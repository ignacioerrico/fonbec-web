{
  "App": {
    "BaseUrl": "https://localhost:5001"
  },
  "BlobStorage": {
    "ContainerName": "documents",
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": [
      "text/plain",
      "application/pdf",
      "image/jpeg",
      "image/png"
    ]
  },
  "ConnectionStrings": {
    "FonbecWebDbContextConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Fonbec.Web.Db;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}