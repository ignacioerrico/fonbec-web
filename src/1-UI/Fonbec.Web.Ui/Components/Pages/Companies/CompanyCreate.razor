@attribute [Route(NavRoutes.CompanyCreate)]
@attribute [Authorize(Policy = nameof(CompanyCreate))]
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.Logic.Models
@using Fonbec.Web.Logic.Util

<PageHeader Title="Alta de empresa" />

<LoadingIndicator Loading="Loading" />

<MudForm @ref="_form" ValidationDelay="0">
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h6">Información de la empresa</MudText>

            <MudTextField T="string"
                          Label="Nombre"
                          @bind-Value="_bindModel.CompanyName"
                          Immediate="true"
                          Required="true"
                          RequiredError="Este es un campo obligatorio."
                          MaxLength="@MaxLength.Company.Name"
                          Validation="@(new Func<string, string?>(ValidateNameFormat))" />

            <MudTextField T="string"
                          Label="Correo electrónico"
                          @bind-Value="_bindModel.CompanyEmail"
                          MaxLength="@MaxLength.Company.Email"
                          Immediate="true"
                          Validation="@(new Func<string, string?>(ContactFieldValidator.ValidateEmail))" />

            <MudTextField T="string"
                          Label="Teléfono"
                          @bind-Value="_bindModel.CompanyPhoneNumber"
                          MaxLength="@MaxLength.Company.PhoneNumber"
                          Immediate="true"
                          Validation="@(new Func<string, string?>(ContactFieldValidator.ValidatePhone))" />

            <MudTextField T="string"
                          Label="Notas personales"
                          @bind-Value="_bindModel.CompanyNotes"
                          MaxLength="@MaxLength.Auditable.Notes" />
        </MudCardContent>
    </MudCard>

    <MudGrid Spacing="4" Class="mt-4">
        <MudItem xs="12" md="7">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Contactos administrativos</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        Personas de consulta que no son padrinos. El nombre es obligatorio.
                    </MudText>

                    @if (_bindModel.PointsOfContact.Count == 0)
                    {
                        <MudText Class="mb-4 mud-text-secondary">No hay contactos administrativos.</MudText>
                    }

                    @foreach (var contact in _bindModel.PointsOfContact)
                    {
                        <MudPaper @key="contact.TempId" Outlined="true" Class="pa-4 mb-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                <MudText Typo="Typo.subtitle2">@ContactHeading(contact)</MudText>
                                <MudTooltip Text="Quitar contacto" Arrow="true" Placement="Placement.Left">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   aria-label="@($"Quitar a {ContactHeading(contact)}")"
                                                   OnClick="@(() => RemovePointOfContact(contact))" />
                                </MudTooltip>
                            </MudStack>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Value="contact.PocFirstName" ValueChanged="@(value => SetContactFirstName(contact, value))"
                                                  Immediate="true" TextUpdateSuppression="false" DebounceInterval="0"
                                                  Required="true" RequiredError="El nombre es obligatorio"
                                                  Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  MaxLength="MaxLength.PointOfContact.FirstName" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="contact.PocLastName" Immediate="true"
                                                  Label="Apellido" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  MaxLength="MaxLength.PointOfContact.LastName" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="contact.PocNickName" Immediate="true"
                                                  Label="Apodo" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  MaxLength="MaxLength.PointOfContact.NickName" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="contact.PocEmail" Immediate="true"
                                                  Label="Correo electrónico" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  MaxLength="MaxLength.PointOfContact.Email"
                                                  Validation="@(new Func<string, string?>(ContactFieldValidator.ValidateEmail))" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="contact.PocPhoneNumber" Immediate="true"
                                                  Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  MaxLength="MaxLength.PointOfContact.PhoneNumber"
                                                  Validation="@(new Func<string, string?>(ContactFieldValidator.ValidatePhone))" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" @bind-Value="contact.PocNotes" Immediate="true"
                                                  Label="Notas" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Lines="2"
                                                  MaxLength="MaxLength.Auditable.Notes" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }

                    <MudButton OnClick="AddPointOfContact"
                               Disabled="!CanAddPointOfContact"
                               StartIcon="@Icons.Material.Filled.Add"
                               Variant="Variant.Outlined"
                               Color="Color.Primary">
                        Agregar contacto
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Padrinos vinculados</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        Solo padrinos que todavía no pertenecen a una empresa. Quitar uno no lo elimina.
                    </MudText>

                    @if (_bindModel.Sponsors.Count == 0)
                    {
                        <MudText Class="mb-4 mud-text-secondary">No hay padrinos vinculados.</MudText>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-center gap-1 mb-4">
                            @foreach (var sponsor in _bindModel.Sponsors)
                            {
                                <MudChip @key="sponsor.Key" T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         Icon="@Icons.Material.Filled.Person"
                                         OnClose="@(_ => RemoveSponsor(sponsor))">
                                    @sponsor.DisplayName
                                </MudChip>
                            }
                        </div>
                    }

                    <MudAutocomplete @ref="_sponsorAutocomplete"
                                     T="SelectableModel<int>"
                                     Label="Agregar padrino"
                                     Placeholder="Buscar por nombre"
                                     SearchFunc="SearchSponsors"
                                     ValueChanged="AddSponsor"
                                     ToStringFunc="@(sponsor => sponsor?.DisplayName)"
                                     Disabled="_sponsorsLoading"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Adornment="Adornment.Start" />
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Class="pt-4">
        <MudButton OnClick="Save" Disabled="SaveButtonDisabled"
                   Variant="Variant.Filled" Color="Color.Primary">
            Crear
        </MudButton>
        <MudButton Href="@NavRoutes.Companies"
                   Variant="Variant.Filled" Color="Color.Default">
            Cancelar
        </MudButton>
    </MudStack>

    <LoadingIndicator Loading="_saving" LoadingText="Guardando los datos" />
</MudForm>