@attribute [Route(NavRoutes.ChapterSettings)]
@attribute [Authorize(Policy = nameof(ChapterSettings))]
@using Fonbec.Web.DataAccess.Entities.Enums
@inherits AuthenticationRequiredComponentBase

<PageHeader Title="Configuración de la filial" />

<LoadingIndicator Loading="Loading" />

@if (!Loading && _behavior is DocumentRejectionBehavior behavior)
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">Cuando se rechaza un documento</MudText>
        <MudRadioGroup T="DocumentRejectionBehavior" Value="behavior" ValueChanged="OnBehaviorChanged" Disabled="_saving">
            <MudRadio Value="DocumentRejectionBehavior.ReturnToFacilitator" Color="Color.Primary">
                <MudStack Spacing="1">
                    <MudText>Devolver al mediador y avisarle por correo</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        El mediador ve el motivo en Mis becarios y puede volver a subirlo.
                    </MudText>
                </MudStack>
            </MudRadio>
            <MudRadio Value="DocumentRejectionBehavior.HoldForManager" Color="Color.Primary">
                <MudStack Spacing="1">
                    <MudText>El coordinador decide si se comparte o se devuelve</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        El documento queda en Documentos rechazados. El mediador no lo ve como rechazado hasta que se lo devuelvas.
                    </MudText>
                </MudStack>
            </MudRadio>
        </MudRadioGroup>
    </MudPaper>
}