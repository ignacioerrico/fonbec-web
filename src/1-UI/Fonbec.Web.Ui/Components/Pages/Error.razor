@page "/Error"
@using System.Diagnostics

<PageTitle>Algo salió mal</PageTitle>

<MudText Typo="Typo.h4" Color="Color.Error" GutterBottom="true">Algo salió mal</MudText>

<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
    Ocurrió un error inesperado. Podés reintentar o volver al inicio.
</MudAlert>

@if (ShowRequestId)
{
    <MudText Typo="Typo.body2" Class="mb-4">
        <strong>Código:</strong> <code>@RequestId</code>
    </MudText>
}

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">Volver al inicio</MudButton>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
