@attribute [Route(NavRoutes.StudentMessages)]
@attribute [Authorize(Policy = nameof(StudentMessages))]
@inherits AuthenticationRequiredComponentBase

<PageTitle>Mensajes para becarios</PageTitle>
<PageHeader Title="Mensajes para becarios" />

<LoadingIndicator Loading="Loading" />

@if (!Loading)
{
    <MudTextField T="string" @bind-Value="_searchString"
                  Placeholder="Buscar"
                  Clearable="true" Immediate="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  IconSize="Size.Medium"
                  Class="mb-2"
                  Style="max-width: 24rem" />

    <MudStack Spacing="6" Class="mt-4">
        @foreach (var messageSection in Sections)
        {
            <div>
                <MudText Typo="Typo.h5" Class="mb-3">@messageSection.Title</MudText>
                @if (messageSection.Items.Count == 0 && (messageSection.Pending || !_hasMoreDelivered))
                {
                    <MudText Class="mud-text-secondary">@messageSection.EmptyText</MudText>
                }
                else
                {
                    @foreach (var item in messageSection.Items)
                    {
                        <MudPaper Outlined="true" Class="pa-4 mb-3" @key="item.RecipientMessageId">
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                                Para @item.StudentRoleLabel: <strong>@item.StudentFullName</strong>
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                De @item.SenderKindLabel: @item.SenderName · Enviado el @item.SentOnLabel
                            </MudText>
                            @if (!CanShare)
                            {
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @ResponsibleFacilitatorLine(item)
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(item.FacilitatorEmail))
                                    {
                                        <MudTooltip Text="@($"Escribirle a {item.FacilitatorFullName}")">
                                            <MudIconButton Icon="@Icons.Material.Outlined.Email"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           Href="@($"mailto:{item.FacilitatorEmail}")"
                                                           aria-label="@($"Escribirle a {item.FacilitatorFullName}")" />
                                        </MudTooltip>
                                    }
                                </div>
                            }
                            @if (!messageSection.Pending)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    Entregado el @item.SharedOnLabel
                                </MudText>
                            }
                            <div class="student-message-body mt-3">@item.Body</div>
                            @if (CanShare)
                            {
                                <div class="d-flex justify-end gap-2 mt-3">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Disabled="_updating"
                                               OnClick="@(() => CopyAsync(item))">
                                        Copiar
                                    </MudButton>
                                    @if (messageSection.Pending)
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="_updating"
                                                   OnClick="@(() => MarkAsync(item))">
                                            Ya lo compartí
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   Disabled="_updating"
                                                   OnClick="@(() => UndoAsync(item))">
                                            Deshacer
                                        </MudButton>
                                    }
                                </div>
                            }
                        </MudPaper>
                    }
                }
                @if (!messageSection.Pending && _hasMoreDelivered)
                {
                    <div @ref="_deliveredSentinel" class="student-messages-sentinel"></div>
                }
                @if (!messageSection.Pending && _loadingMore)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
                }
            </div>
        }
    </MudStack>
}