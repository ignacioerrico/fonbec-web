@attribute [Route(NavRoutes.ManagerUploadDocumentTemplate)]
@attribute [Authorize(Policy = nameof(ManagerUploadDocument))]
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.Ui.Components.NonPages.Documents

<PageHeader Title="Subir documento" />

<LoadingIndicator Loading="Loading" />

@if (!Loading && _context is not null)
{
    <UploadDocumentForm DocumentType="_context.DocumentType"
                        EducationLevel="_context.EducationLevel"
                        AllowsTextContent="_context.AllowsTextContent"
                        StudentFullName="@_context.StudentFullName"
                        FacilitatorFullName="@_context.FacilitatorFullName"
                        RecipientName="@_context.RecipientName"
                        PlanPeriodLabel="@_context.PlanPeriodLabel"
                        RecipientIsCompany="_context.CompanyId.HasValue"
                        ChapterId="_context.ChapterId"
                        CancelHref="@NavRoutes.Students"
                        OnSubmit="HandleSubmitAsync" />
}