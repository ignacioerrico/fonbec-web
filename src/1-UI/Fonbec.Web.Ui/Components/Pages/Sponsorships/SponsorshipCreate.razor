@page "/becarios/{studentId:int}/padrinos/alta"
@attribute [Authorize(Policy = nameof(SponsorshipCreate))]
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.DataAccess.Entities.Enums
@using Fonbec.Web.Logic.Models.Sponsorships

<PageHeader Title="@PageTitle" />

<LoadingIndicator Loading="Loading" />

<MudPaper Class="pa-6 mt-4" Elevation="1">
    @if (!Loading && _studentNotFound)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            El becario especificado no es válido o no existe.
        </MudAlert>

        <MudButton Href="@NavRoutes.Students"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Volver a la lista de becarios
        </MudButton>
    }
    else if (!Loading)
    {
        @if (!AnySponsorsOrCompanies)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @if (_bindModel.SponsorshipType == SponsorshipType.Sponsor)
                {
                    <span>
                        No hay padrinos. Para asignar un padrino se requiere
                        <MudLink Href="@NavRoutes.SponsorCreate" Typo="Typo.body2">
                            al menos un padrino
                        </MudLink>.
                    </span>
                }
                else if (_bindModel.SponsorshipType == SponsorshipType.Company)
                {
                    <span>
                        No hay empresas. Para asignar una empresa se requiere
                        <MudLink Href="@NavRoutes.CompanyCreate" Typo="Typo.body2">
                            al menos una empresa
                        </MudLink>.
                    </span>
                }
            </MudAlert>
        }

        <MudStack>
            <MudToggleGroup T="SponsorshipType"
                            SelectionMode="SelectionMode.SingleSelection"
                            Value="_bindModel.SponsorshipType"
                            ValueChanged="OnSponsorshipTypeChanged"
                            Color="Color.Primary"
                            Style="align-self: flex-start;"
                            CheckMark>
                <MudToggleItem Value="SponsorshipType.Sponsor"
                               Text="Padrino"
                               SelectedIcon="@Icons.Material.Filled.Person" />

                <MudToggleItem Value="SponsorshipType.Company"
                               Text="Empresa"
                               SelectedIcon="@Icons.Material.Filled.Business" />
            </MudToggleGroup>

            @if (_periodStatus == SponsorshipPeriodStatus.OverlapsExisting)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    Ya existe un apadrinamiento entre este becario y
                    @SponsorshipPartyLabel que se superpone con el período seleccionado.
                    Elegí otro período.
                </MudAlert>
            }
            else if (_periodStatus == SponsorshipPeriodStatus.ExtendsExisting)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    El período seleccionado continúa un apadrinamiento existente.
                    Al confirmar, se extenderá ese apadrinamiento en lugar de crear uno nuevo.
                </MudAlert>
            }

            <MudDivider />

            <MudForm @bind-IsValid="_formValidationSucceeded"
                     Disabled="!AnySponsorsOrCompanies">
                <MudStack>
                    @if (_bindModel.SponsorshipType == SponsorshipType.Sponsor)
                    {
                        <SponsorSelector SelectedSponsor="_bindModel.SelectedSponsor"
                                         SelectedSponsorChanged="OnSponsorChanged"
                                         IsRequired="true"
                                         ChapterId="FonbecClaim?.ChapterId"
                                         NumberOfSponsorsLoaded="NumberOfSponsorsLoaded" />
                    }
                    else if (_bindModel.SponsorshipType == SponsorshipType.Company)
                    {
                        <CompanySelector SelectedCompanyId="_bindModel.SelectedCompanyId"
                                         SelectedCompanyIdChanged="OnCompanyChanged"
                                         IsRequired="true"
                                         NumberOfCompaniesLoaded="NumberOfCompaniesLoaded" />
                    }

                    <MudDatePicker Label="Fecha de inicio"
                                   Date="_bindModel.SponsorshipStartDate"
                                   DateChanged="OnStartDateChanged"
                                   OpenTo="OpenTo.Month"
                                   FixDay="1"
                                   DateFormat="\P\r\i\n\c\i\p\i\o\ \d\e\ MMMM yyyy"
                                   TitleDateFormat="MMM yyyy"
                                   Culture="@System.Globalization.CultureInfo.GetCultureInfo("es-AR")"
                                   Required="true"
                                   MaxDate="_bindModel.SponsorshipEndDate" />

                    <MudCheckBox T="bool"
                                 Value="_isEndDateKnown"
                                 ValueChanged="OnIsEndDateKnownCheckBoxChanged"
                                 Label="Conozco la fecha de fin"
                                 Color="Color.Primary" />

                    @if (_isEndDateKnown)
                    {
                        <MudDatePicker Label="Fecha de fin"
                                       Date="_bindModel.SponsorshipEndDate"
                                       DateChanged="OnEndDateChanged"
                                       OpenTo="OpenTo.Month"
                                       FixDay="1"
                                       DateFormat="\F\i\n\ \d\e\ MMMM yyyy"
                                       TitleDateFormat="MMM yyyy"
                                       Culture="@System.Globalization.CultureInfo.GetCultureInfo("es-AR")"
                                       Required="_isEndDateKnown"
                                       Disabled="!_isEndDateKnown"
                                       MinDate="_bindModel.SponsorshipStartDate" />
                    }

                    <MudTextField T="string"
                                  Label="Información adicional"
                                  @bind-Value="_bindModel.SponsorshipNotes"
                                  Immediate="true"
                                  MaxLength="MaxLength.Auditable.Notes" />
                </MudStack>
            </MudForm>

            <MudDivider />

            <MudStack Row="true">
                <MudButton OnClick="Save"
                           Disabled="SaveButtonDisabled"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Color="Color.Primary">
                    @PrimaryActionLabel
                </MudButton>

                <MudButton Href="@NavRoutes.Sponsorships(StudentId)"
                           Variant="Variant.Filled"
                           Color="Color.Default">
                    Cancelar
                </MudButton>
            </MudStack>
        </MudStack>
    }
</MudPaper>

<LoadingIndicator Loading="_saving" LoadingText="Guardando los datos" />
