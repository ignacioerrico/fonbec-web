@attribute [Route(NavRoutes.SponsorCreate)]
@attribute [Authorize(Policy = nameof(SponsorCreate))]
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.Logic.Util

<PageHeader Title="Alta de Padrino" />

@if (!_anyChapters)
{
    <MudAlert Severity="Severity.Error">No hay filiales. Para dar de alta usuarios se requiere <MudLink Href="@NavRoutes.ChapterCreate" Typo="Typo.body2">al menos una filial</MudLink>.</MudAlert>
}

<LoadingIndicator Loading="Loading" />

<MudForm @ref="_form" @bind-IsValid="@_formValidationSucceeded" Disabled="!_anyChapters">
    <ChapterSelector @bind-SelectedChapterId="_bindModel.ChapterId"
                     NumberOfChaptersLoaded="OnChaptersLoaded" />

    <MudTextField T="string" Label="Nombre" @bind-Value="_bindModel.SponsorFirstName" Immediate="true" AutoFocus="_anyChapters"
                  Required="true" RequiredError="Este es un campo obligatorio."
                  MaxLength="MaxLength.FonbecWebUser.FirstName" />

    <MudTextField T="string" Label="Apellido" @bind-Value="_bindModel.SponsorLastName" Immediate="true"
                  Required="true" RequiredError="Este es un campo obligatorio."
                  MaxLength="MaxLength.FonbecWebUser.LastName" />

    <MudTextField T="string" Label="Apodo" @bind-Value="_bindModel.SponsorNickName" Immediate="true"
                  MaxLength="MaxLength.FonbecWebUser.NickName" />

    <GenderSelector @bind-SelectedGender="_bindModel.SponsorGender" />

    <MudTextField T="string" Label="Correo electrónico" @bind-Value="_bindModel.SponsorEmail" Immediate="true"
                  Required="true" RequiredError="Este es un campo obligatorio."
                  MaxLength="MaxLength.FonbecWebUser.Email"
                  Validation="@(new Func<string, string?>(ContactFieldValidator.ValidateEmail))" />

    <MudTextField T="string" Label="Teléfono" @bind-Value="_bindModel.SponsorPhoneNumber" Immediate="true"
                  MaxLength="MaxLength.FonbecWebUser.PhoneNumber"
                  Validation="@(new Func<string, string?>(ContactFieldValidator.ValidatePhone))" />

    <CompanySelector @bind-SelectedCompanyId="_bindModel.CompanyId" />

    <MudTextField T="string" Label="Información adicional" @bind-Value="_bindModel.SponsorNotes" Immediate="true"
                  MaxLength="MaxLength.Auditable.Notes" />

    <MudCard Class="mt-4">
        <MudCardContent>
            <MudText Typo="Typo.h6">Destinatarios adicionales</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                Direcciones adicionales del padrino. CC queda visible para los demás destinatarios; BCC queda oculta.
            </MudText>

            @if (_bindModel.Recipients.Count > 0)
            {
                <MudTable Items="_bindModel.Recipients"
                          Dense="true" Hover="true" Striped="true" Bordered="true">
                    <HeaderContent>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Correo electrónico</MudTh>
                        <MudTh>Envío</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudTextField @bind-Value="context.RecipientName"
                                          @bind-Value:after="RevalidateRecipientsAsync"
                                          Label="Nombre"
                                          Immediate="true"
                                          Required="true"
                                          RequiredError="Este es un campo obligatorio."
                                          MaxLength="@MaxLength.SendAlsoTo.Name" />
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string" @bind-Value="context.RecipientEmail"
                                          @bind-Value:after="RevalidateRecipientsAsync"
                                          Label="Correo electrónico"
                                          Immediate="true"
                                          Required="true"
                                          RequiredError="Este es un campo obligatorio."
                                          MaxLength="@MaxLength.FonbecWebUser.Email"
                                          Validation="@(new Func<string, string?>(email => ValidateRecipientEmail(context, email)))" />
                        </MudTd>
                        <MudTd>
                            <MudSelect T="bool" @bind-Value="context.SendAsBcc"
                                       Label="Envío"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="bool" Value="false">CC</MudSelectItem>
                                <MudSelectItem T="bool" Value="true">BCC</MudSelectItem>
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           aria-label="Quitar destinatario"
                                           OnClick="@(() => RemoveRecipient(context.TempId))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Class="my-4">No hay destinatarios adicionales.</MudText>
            }

            <MudButton OnClick="AddRecipient"
                       Disabled="@(!CanAddRecipient)"
                       StartIcon="@Icons.Material.Filled.Add"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="mt-4">
                Agregar destinatario
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudForm>

<MudStack Row="true" Class="pt-4">
    <MudButton OnClick="Save" Disabled="SaveButtonDisabled"
               Variant="Variant.Filled" Color="Color.Primary">
        Crear
    </MudButton>
    <MudButton Href="@NavRoutes.Sponsors"
               Variant="Variant.Filled" Color="Color.Default" Class="ms-4">
        Cancelar
    </MudButton>
</MudStack>

<LoadingIndicator Loading="_saving" LoadingText="Guardando los datos" />