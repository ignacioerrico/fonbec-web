@attribute [Route(NavRoutes.Students)]
@attribute [Authorize(Policy = nameof(StudentsList))]
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.DataAccess.Entities.Enums
@using Fonbec.Web.Logic.Models.Students
@using Fonbec.Web.Ui.Components.Pages.Managers
@using Fonbec.Web.Ui.Components.Pages.Sponsorships
@using Fonbec.Web.Ui.Constants

<PageHeader Title="Becarios" />

<MudStack Row="true" AlignItems="AlignItems.Center">
    <AuthorizeView Policy="@nameof(StudentCreate)">
        <MudTooltip Text="Alta de becario"
                    Arrow="true" Placement="Placement.Right"
                    Color="Color.Primary">
            <MudFab Href="@NavRoutes.StudentCreate"
                    StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary" />
        </MudTooltip>
    </AuthorizeView>
    <MudSpacer />
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
        <MudTooltip Text="Muestra nivel, notas y evaluación"
                    Arrow="true" Placement="Placement.Bottom">
            <MudSwitch @bind-Value="_fullView" Color="Color.Primary" LabelPlacement="Placement.Start">
                Vista completa
            </MudSwitch>
        </MudTooltip>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
        <MudSwitch @bind-Value="_sortByLastName" LabelPlacement="Placement.Start">
            @(_sortByLastName ? "Apellido, Nombre" : "Nombre Apellido")
        </MudSwitch>
    </MudStack>
</MudStack>

<LoadingIndicator Loading="Loading"
                  If="!_viewModels.Any()"
                  ThenDisplay="No hay becarios." />

@if (_viewModels.Any())
{
    <RelatedCountFilter Class="mt-4"
                        Caption="Padrinos"
                        Noun="padrino"
                        Hint="Cuenta padrinos vigentes o por comenzar. Los finalizados no se incluyen."
                        @bind-Value="_sponsorCountFilter" />

    <MudDataGrid T="StudentsListViewModel"
                 Items="_viewModels"
                 Dense="true" Hover="true" Striped="true" Bordered="true"
                 ReadOnly="false"
                 CommittedItemChanges="@(async viewModel => await CommittedItemChangesAsync(viewModel))"
                 EditMode="DataGridEditMode.Form"
                 EditTrigger="DataGridEditTrigger.Manual"
                 QuickFilter="Filter"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                 StartedEditingItem="StartedEditingItem"
                 SortMode="SortMode.Multiple"
                 Class="mt-2">
        <ToolBarContent>
            <MudTextField T="string" @bind-Value="_searchString"
                          Placeholder="Buscar"
                          Clearable="true" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
        </ToolBarContent>
        <Columns>
            @if (ShowLetterAssessments)
            {
                <HierarchyColumn T="StudentsListViewModel"
                                 ButtonDisabledFunc="@(vm => !vm.HasLetterAssessment)"
                                 EnableHeaderToggle="false"
                                 Hidden="@(!_fullView)" />
            }
            <PropertyColumn Property="@(vm => $"{vm.StudentFirstName} {vm.StudentLastName} {vm.StudentNickName} {vm.StudentLastName}")" Title="Nombre">
                <CellTemplate>
                    <AuditableItemDisplay Id="@context.Item.StudentId"
                                          ItemName="@StudentFullName(context.Item)"
                                          Nickname="@context.Item.StudentNickName"
                                          Email="@context.Item.StudentEmail"
                                          Phone="@context.Item.StudentPhoneNumber"
                                          IsActive="@context.Item.IsStudentActive"
                                          AuditableViewModel="@context.Item" />
                </CellTemplate>
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="@context.Item.StudentFirstName" Immediate="true"
                                  Required="true" RequiredError="Este es un campo requerido"
                                  Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.FirstName" />
                    <MudTextField T="string" @bind-Value="@context.Item.StudentLastName" Immediate="true" Class="mt-4"
                                  Required="true" RequiredError="Este es un campo requerido"
                                  Label="Apellido" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.LastName" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="vm => vm.StudentNickName" Title="Apodo" Hidden="true" Required="false">
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="context.Item.StudentNickName" Immediate="true"
                                  Label="Apodo" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.NickName" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="vm => vm.StudentGender" Title="Sexo" Hidden="true">
                <EditTemplate>
                    <MudSelect T="Gender" @bind-Value="context.Item.StudentGender" Class="mt-4"
                               Label="Sexo" Variant="Variant.Outlined" Margin="@Margin.Dense">
                        <MudSelectItem Value="Gender.Male">Masculino</MudSelectItem>
                        <MudSelectItem Value="Gender.Female">Femenino</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="vm => vm.FacilitatorFullName" Title="Mediador">
                <EditTemplate>
                    <FacilitatorSelector @bind-SelectedFacilitatorId="context.Item.FacilitatorId"
                                         ChapterId="context.Item.ChapterId" />
                </EditTemplate>
                <FilterTemplate>
                    <FilterByList T="StudentsListViewModel"
                                  AllItems="_allFacilitators"
                                  FilterContext="context"
                                  FilterBy="@(vm => vm.FacilitatorFullName)" />
                </FilterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="@(vm => string.Join(", ", vm.ActiveSponsors.Select(s => s.Name)))"
                            Title="Padrinos" Editable="false" Sortable="false">
                <CellTemplate>
                    <AuthorizeView Policy="@nameof(SponsorshipsList)" Context="sponsorshipsContext">
                        <Authorized>
                            <StudentSponsorsCell StudentId="@context.Item.StudentId"
                                                 Sponsors="@context.Item.ActiveSponsors"
                                                 SponsorshipsHref="@NavRoutes.Sponsorships(context.Item.StudentId)" />
                        </Authorized>
                        <NotAuthorized>
                            <StudentSponsorsCell StudentId="@context.Item.StudentId"
                                                 Sponsors="@context.Item.ActiveSponsors" />
                        </NotAuthorized>
                    </AuthorizeView>
                </CellTemplate>
                <EditTemplate>
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="vm => vm.StudentCurrentEducationLevel" Title="Nivel" Hidden="@(!_fullView)">
                <EditTemplate>
                    <EducationLevelSelector @bind-SecondarySchoolStartYear="context.Item.StudentSecondarySchoolStartYear"
                                            @bind-UniversityStartYear="context.Item.StudentUniversityStartYear" />
                </EditTemplate>
                <FilterTemplate>
                    <FilterByList T="StudentsListViewModel"
                                  AllItems="_allEducationLevels"
                                  FilterContext="context"
                                  FilterBy="@(vm => vm.StudentCurrentEducationLevel)" />
                </FilterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="vm => vm.LatestReportCardAssessmentLabel" Title="Notas" Editable="false" Hidden="@(!_fullView)">
                <CellTemplate>
                    @if (context.Item.LatestReportCardAssessment is { } assessment)
                    {
                        <MudTooltip Text="@ReportCardAssessmentTooltip(assessment)" Arrow="true">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="@assessment.Assessment.Color()">
                                @assessment.Assessment.Label()
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">—</MudText>
                    }
                </CellTemplate>
                <FilterTemplate>
                    <FilterByList T="StudentsListViewModel"
                                  AllItems="_allReportCardAssessments"
                                  FilterContext="context"
                                  FilterBy="@(vm => vm.LatestReportCardAssessmentLabel)" />
                </FilterTemplate>
            </PropertyColumn>

            @if (ShowLetterAssessments)
            {
                <TemplateColumn Title="Evaluación"
                                Filterable="false"
                                Sortable="true"
                                Hidden="@(!_fullView)"
                                SortBy="@(vm => vm.LetterAssessmentSortKey)">
                    <CellTemplate>
                        @if (context.Item.LetterAssessment is { } assessment)
                        {
                            <MudTooltip Text="Promedio de ortografía, legibilidad y contenido" Arrow="true">
                                <MudText Typo="Typo.body2">@assessment.OverallText</MudText>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            <PropertyColumn Property="vm => vm.Notes" Title="Información adicional" Hidden="true" Required="false">
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="context.Item.Notes" Immediate="true"
                                  Label="Información adicional" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.Auditable.Notes" />
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn Property="vm => vm.StudentChapterName" Title="Filiar"
                            Editable="false" Hidden="@(FonbecClaim.ChapterId is not null)">
                <EditTemplate>
                </EditTemplate>
                <FilterTemplate>
                    <FilterByList T="StudentsListViewModel"
                                  AllItems="_allChapters"
                                  FilterContext="context"
                                  FilterBy="@(vm => vm.StudentChapterName)" />
                </FilterTemplate>
            </PropertyColumn>

            <TemplateColumn Title="Acciones" Filterable="false" Sortable="false">
                <CellTemplate>
                    <AuthorizeView Policy="@nameof(StudentCreate)" Context="innerContext">
                        <MudTooltip Text="Editar" Arrow="true" Placement="Placement.Bottom" Color="Color.Primary" Delay="500">
                            <MudIconButton OnClick="@context.Actions.StartEditingItemAsync"
                                           Disabled="@(!context.Item.IsStudentActive)"
                                           Icon="@Icons.Material.Outlined.Edit" Size="@Size.Small" Color="Color.Primary" />
                        </MudTooltip>
                    </AuthorizeView>

                    <AuthorizeView Policy="@nameof(SponsorshipsList)" Context="sponsorshipsContext">
                        <MudTooltip Text="@($"Ver apadrinamientos de {StudentFullName(context.Item)}")"
                                    Arrow="true" Placement="Placement.Bottom" Color="Color.Primary" Delay="500">
                            <MudIconButton Href="@NavRoutes.Sponsorships(context.Item.StudentId)"
                                           Icon="@Icons.Material.Outlined.VolunteerActivism"
                                           Size="@Size.Small"
                                           Color="Color.Primary" />
                        </MudTooltip>
                    </AuthorizeView>

                    <AuthorizeView Policy="@nameof(ManagerStudentDocumentHistory)" Context="historyContext">
                        <MudTooltip Text="Historial de documentos"
                                    Arrow="true" Placement="Placement.Bottom" Color="Color.Primary" Delay="500">
                            <MudIconButton Href="@NavRoutes.ManagerStudentDocumentHistory(context.Item.StudentId)"
                                           Icon="@Icons.Material.Outlined.History"
                                           Size="@Size.Small"
                                           Color="Color.Primary" />
                        </MudTooltip>
                    </AuthorizeView>

                    <AuthorizeView Policy="@nameof(ManagerUploadDocument)" Context="uploadContext">
                        @if (context.Item.HasActiveSponsors)
                        {
                            <MudTooltip Text="Subir documento" Arrow="true" Placement="Placement.Bottom" Color="Color.Secondary">
                                <MudIconButton OnClick="@(() => OpenUploadDialogAsync(context.Item))"
                                               Disabled="@(!context.Item.IsStudentActive)"
                                               Icon="@Icons.Material.Outlined.FileUpload"
                                               Size="@Size.Small"
                                               Color="Color.Secondary" />
                            </MudTooltip>
                        }
                    </AuthorizeView>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            @if (context.Item.LetterAssessment is { } assessment)
            {
                <MudPaper Class="pa-4" Elevation="0">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2">Promedio</MudText>
                        <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2">Ortografía: @assessment.SpellingText</MudText>
                            <MudText Typo="Typo.body2">Legibilidad: @assessment.PenmanshipText</MudText>
                            <MudText Typo="Typo.body2">Contenido: @assessment.ContentText</MudText>
                        </MudStack>
                        @if (assessment.ShowTrend)
                        {
                            <MudText Typo="Typo.subtitle2">Evolución</MudText>
                            <MudChart ChartType="ChartType.Line"
                                      ChartSeries="@AssessmentSeries(assessment)"
                                      XAxisLabels="@assessment.PlanLabels"
                                      Width="100%"
                                      Height="280px" />
                        }
                    </MudStack>
                </MudPaper>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-4 mud-text-secondary">No hay resultados.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="StudentsListViewModel" RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} of {all_items}" />
        </PagerContent>
    </MudDataGrid>
}