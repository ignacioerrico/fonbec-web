@attribute [Route(NavRoutes.FacilitatorStudents)]
@attribute [Authorize(Policy = nameof(FacilitatorStudentsList))]
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.DataAccess.Entities.Enums
@using Fonbec.Web.Logic.Models.Facilitators

<PageHeader Title="Mis becarios" />

@if (_dashboard.CurrentPlanLabel is { } currentPlan)
{
    <MudText Typo="Typo.h4" Class="mb-4">Campaña actual: @currentPlan</MudText>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">No hay una campaña activa</MudText>
}

<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudSwitch @bind-Value="_onlyMissingOrRejectedLetters" LabelPlacement="Placement.End" Color="Color.Primary">
        Solo cartas faltantes o rechazadas
    </MudSwitch>
    <MudSpacer />
    <MudSwitch @bind-Value="_sortByLastName" LabelPlacement="Placement.Left">
        @(_sortByLastName ? "Apellido, Nombre" : "Nombre Apellido")
    </MudSwitch>
</MudStack>

<LoadingIndicator Loading="Loading"
                  If="!_dashboard.Students.Any()"
                  ThenDisplay="No hay becarios." />

@if (_dashboard.Students.Any())
{
    <MudDataGrid T="FacilitatorStudentsListViewModel"
                 Items="_dashboard.Students"
                 Dense="true" Hover="true" Striped="true" Bordered="true"
                 ReadOnly="true"
                 QuickFilter="FilterStudents"
                 SortMode="SortMode.Multiple"
                 Class="mt-4">
        <ToolBarContent>
            <MudTextField T="string" @bind-Value="_searchString"
                          Placeholder="Buscar"
                          Clearable="true" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
        </ToolBarContent>
        <Columns>
            <HierarchyColumn ButtonDisabledFunc="@(vm => false)" EnableHeaderToggle="true" />
            <PropertyColumn Property="@(vm => _sortByLastName ? vm.StudentLastName : vm.StudentFirstName)" Title="Becario">
                <CellTemplate>
                    <MudText Color="Color.Primary">
                        <strong>@StudentFullName(context.Item)</strong>
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="@LetterColumnTitle" Filterable="false" Sortable="false">
                <CellTemplate>
                    <div class="mt-2 d-flex align-center gap-1">
                        <MudTooltip Text="@context.Item.LetterAggregate.Label()" Arrow="true" Placement="Placement.Right">
                            @if (context.Item.ShowLetterCountBadge)
                            {
                                <MudBadge Content="@($"{context.Item.UploadedLetterCount}/{context.Item.SponsorLetterCount}")"
                                          Color="@context.Item.LetterAggregate.Color()" Overlap="true" Bordered="true">
                                    <MudIconButton Icon="@context.Item.LetterAggregate.Icon()"
                                                   Color="@context.Item.LetterAggregate.Color()"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ShowLetterDetailsAsync(context.Item))"
                                                   aria-label="@LetterDetailsAriaLabel(context.Item)" />
                                </MudBadge>
                            }
                            else
                            {
                                <MudIconButton Icon="@context.Item.LetterAggregate.Icon()"
                                               Color="@context.Item.LetterAggregate.Color()"
                                               Size="Size.Small"
                                               OnClick="@(() => ShowLetterDetailsAsync(context.Item))"
                                               aria-label="@LetterDetailsAriaLabel(context.Item)" />
                            }
                        </MudTooltip>
                        @if (ShowLetterUpload(context.Item))
                        {
                            @if (context.Item.SponsorsNeedingLetter.Count == 1)
                            {
                                <MudTooltip Text="Subir carta" Arrow="true" Placement="Placement.Right">
                                    <MudIconButton Icon="@Icons.Material.Filled.Upload"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Href="@LetterUploadUrl(context.Item, context.Item.SponsorsNeedingLetter[0])"
                                                   aria-label="Subir carta" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudMenu Dense="true" AnchorOrigin="Origin.BottomCenter">
                                    <ActivatorContent>
                                        <MudTooltip Text="Subir carta" Arrow="true" Placement="Placement.Right">
                                            <MudIconButton Icon="@Icons.Material.Filled.Upload"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           aria-label="Subir carta" />
                                        </MudTooltip>
                                    </ActivatorContent>
                                    <ChildContent>
                                        @foreach (var sponsor in context.Item.SponsorsNeedingLetter)
                                        {
                                            <MudMenuItem Href="@LetterUploadUrl(context.Item, sponsor)"
                                                         Icon="@(sponsor.IsCompany ? Icons.Material.Filled.Factory : Icons.Material.Filled.Person)">
                                                @sponsor.RecipientName
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            }
                        }
                        <MudTooltip Text="Ver historial de cartas" Arrow="true" Placement="Placement.Right">
                            <MudIconButton Icon="@Icons.Material.Filled.History"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Href="@NavRoutes.FacilitatorLetters(context.Item.StudentId)"
                                           aria-label="Ver historial de cartas" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Calificaciones" Filterable="false" Sortable="false">
                <CellTemplate>
                    <div class="mt-2 d-flex align-center gap-1">
                        @if (context.Item.ReportCards.Count > 0)
                        {
                            <div>
                                @foreach (var report in context.Item.ReportCards)
                                {
                                    <MudTooltip Text="@ReportChipStatusText(report)" Arrow="true">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Icon="@report.Status.Icon()"
                                                 IconColor="@report.Status.Color()"
                                                 Class="me-1">
                                            @report.PeriodLabel
                                        </MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        }
                        else
                        {
                            <MudTooltip Text="@ReportCardMissingTooltip(context.Item)" Arrow="true" Placement="Placement.Right">
                                <MudChip T="string" Size="Size.Small" aria-label="@ReportCardMissingTooltip(context.Item)">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" />
                                </MudChip>
                            </MudTooltip>
                        }
                        <MudTooltip Text="@ReportCardUploadLabel(context.Item)" Arrow="true" Placement="Placement.Right">
                            <MudIconButton Icon="@Icons.Material.Filled.Upload"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Href="@NavRoutes.FacilitatorUploadReportCard(context.Item.StudentId)"
                                           aria-label="@ReportCardUploadLabel(context.Item)" />
                        </MudTooltip>
                        @if (context.Item.ReportCards.Count > 0)
                        {
                            <MudTooltip Text="@ReportCardHistoryLabel(context.Item)" Arrow="true" Placement="Placement.Right">
                                <MudIconButton Icon="@Icons.Material.Filled.History"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Href="@NavRoutes.FacilitatorReportCards(context.Item.StudentId)"
                                               aria-label="@ReportCardHistoryLabel(context.Item)" />
                            </MudTooltip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Otros" Filterable="false" Sortable="false">
                <CellTemplate>
                    <div class="mt-2 d-flex align-center gap-1">
                        @if (context.Item.OtherDocuments.HasAny)
                        {
                            <MudTooltip Text="Ver otros documentos" Arrow="true" Placement="Placement.Right">
                                <MudBadge Content="@context.Item.OtherDocuments.Count" Color="Color.Primary" Overlap="true" Bordered="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.History"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Href="@NavRoutes.FacilitatorOtherDocuments(context.Item.StudentId)"
                                                   aria-label="@($"Otros documentos: {context.Item.OtherDocuments.Count}")" />
                                </MudBadge>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Sin otros documentos" Arrow="true" Placement="Placement.Right">
                                <MudChip T="string" Size="Size.Small" aria-label="Sin otros documentos">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" />
                                </MudChip>
                            </MudTooltip>
                        }
                        <MudTooltip Text="Subir otro documento" Arrow="true" Placement="Placement.Right">
                            <MudIconButton Icon="@Icons.Material.Filled.Upload"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Href="@NavRoutes.FacilitatorUploadOther(context.Item.StudentId)"
                                           aria-label="Subir otro documento" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudPaper Class="pa-4" Elevation="0">
                @{
                    var rejectedLetters = RejectedLetters(context.Item);
                }
                <MudStack Row="true" Spacing="8" AlignItems="AlignItems.Start">
                    <MudStack Spacing="1" AlignItems="AlignItems.Start">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2">Nivel Académico</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                            @context.Item.EducationLevel.EnumToString()
                        </MudChip>
                    </MudStack>
                    @if (rejectedLetters.Count > 0)
                    {
                        <MudStack Spacing="1" AlignItems="AlignItems.Start">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Mail" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">
                                    @(rejectedLetters.Count == 1 ? "Carta rechazada" : "Cartas rechazadas")
                                </MudText>
                            </MudStack>
                            @foreach (var letter in rejectedLetters)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">
                                    @RejectedLetterText(letter, rejectedLetters.Count > 1)
                                </MudChip>
                            }
                        </MudStack>
                    }
                </MudStack>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Acciones</MudText>
                @{
                    var sponsorsNeedingLetter = context.Item.SponsorsNeedingLetter;
                }
                <MudStack Row="true" Spacing="2">
                    @if (context.Item.IsLetterExemptForCurrentPlan)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Block" Size="Size.Small" Disabled="true">
                            Eximido
                        </MudButton>
                    }
                    else if (_dashboard.CurrentPlanId is null || sponsorsNeedingLetter.Count == 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Mail" Size="Size.Small" Disabled="true">
                            Subir carta
                        </MudButton>
                    }
                    else if (context.Item.SponsorLetterCount == 1)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Mail" Size="Size.Small"
                                   Href="@LetterUploadUrl(context.Item, sponsorsNeedingLetter[0])">
                            Subir carta
                        </MudButton>
                    }
                    else
                    {
                        <MudMenu>
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Mail"
                                           EndIcon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small">
                                    Subir carta
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                @foreach (var sponsor in sponsorsNeedingLetter)
                                {
                                    <MudMenuItem Href="@LetterUploadUrl(context.Item, sponsor)"
                                                 Icon="@(sponsor.IsCompany ? Icons.Material.Filled.Factory : Icons.Material.Filled.Person)">
                                        @sponsor.RecipientName
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Description" Size="Size.Small"
                               Href="@NavRoutes.FacilitatorUploadReportCard(context.Item.StudentId)">
                        @ReportCardUploadLabel(context.Item)
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Upload" Size="Size.Small"
                               Href="@NavRoutes.FacilitatorUploadOther(context.Item.StudentId)">
                        Subir otro documento
                    </MudButton>
                </MudStack>
            </MudPaper>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="FacilitatorStudentsListViewModel" RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} of {all_items}" />
        </PagerContent>
    </MudDataGrid>
}