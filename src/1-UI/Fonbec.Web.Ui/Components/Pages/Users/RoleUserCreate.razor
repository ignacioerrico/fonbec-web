@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.Logic.Util
@inherits AuthenticationRequiredComponentBase
@inject IStringLocalizer<SharedResources> L

<PageHeader Title="@Title" />

@if (!_hasChapter)
{
    <MudAlert Severity="Severity.Error">@L["NoAssignedChapter"]</MudAlert>
}

<LoadingIndicator Loading="Loading" />

<MudForm @bind-IsValid="@_formValidationSucceeded" Disabled="!_hasChapter">
    <MudTextField T="string" Label="@L["FirstName"]" @bind-Value="_bindModel.UserFirstName" Immediate="true" AutoFocus="_hasChapter"
                  Required="true" RequiredError="@L["Required"]"
                  MaxLength="MaxLength.FonbecWebUser.FirstName" />

    <MudTextField T="string" Label="@L["LastName"]" @bind-Value="_bindModel.UserLastName" Immediate="true"
                  Required="true" RequiredError="@L["Required"]"
                  MaxLength="MaxLength.FonbecWebUser.LastName" />

    <MudTextField T="string" Label="@L["Nickname"]" @bind-Value="_bindModel.UserNickName" Immediate="true"
                  MaxLength="MaxLength.FonbecWebUser.NickName" />

    <GenderSelector @bind-SelectedGender="_bindModel.UserGender" />

    <MudTextField T="string" Label="@L["Email"]" @bind-Value="_bindModel.UserEmail" Immediate="true"
                  Required="true" RequiredError="@L["Required"]"
                  MaxLength="MaxLength.FonbecWebUser.Email"
                  Validation="@(new Func<string, string?>(ValidateEmail))" />

    <MudTextField T="string" Label="@L["Phone"]" @bind-Value="_bindModel.UserPhoneNumber" Immediate="true"
                  MaxLength="MaxLength.FonbecWebUser.PhoneNumber"
                  Validation="@(new Func<string, string?>(ValidatePhone))" />

    <MudTextField T="string" Label="@L["AdditionalInformation"]" @bind-Value="_bindModel.UserNotes" Immediate="true"
                  MaxLength="MaxLength.Auditable.Notes" />
</MudForm>

<MudStack Row="true" Class="pt-4">
    <MudButton OnClick="SaveAsync" Disabled="SaveButtonDisabled"
               Variant="Variant.Filled" Color="Color.Primary">
        @L["Create"]
    </MudButton>
    <MudButton Href="@CancelRoute"
               Variant="Variant.Filled" Color="Color.Default" Class="ms-4">
        @L["Cancel"]
    </MudButton>
</MudStack>

<LoadingIndicator Loading="_saving" LoadingText="@L["Saving"]" />
