@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
@inherits AuthenticationRequiredComponentBase

@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.DataAccess.Entities.Enums
@using Fonbec.Web.Logic.Models.Users
@using Fonbec.Web.Logic.Util
@using Fonbec.Web.Ui.Authorization

<PageHeader Title="@Title" />

<MudStack StretchItems="StretchItems.Middle" Row="true">
    <AuthorizeView Policy="@CreatePolicy">
        <MudTooltip Text="@CreateTooltip"
                    Arrow="true" Placement="Placement.Right"
                    Color="Color.Primary">
            <MudFab Href="@CreateRoute"
                    StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary" />
        </MudTooltip>
    </AuthorizeView>
    <MudSpacer />
    <MudSwitch @bind-Value="_isLastNameFirst" LabelPlacement="Placement.Left">
        @(_isLastNameFirst ? L["LastNameFirst"] : L["FirstNameFirst"])
    </MudSwitch>
</MudStack>

<LoadingIndicator Loading="Loading"
                  If="!_viewModel.Any()"
                  ThenDisplay="@EmptyMessage" />

@if (_viewModel.Any())
{
    <MudDataGrid T="UsersListViewModel"
                 Items="_viewModel"
                 Dense="true" Hover="true" Striped="true" Bordered="true"
                 ReadOnly="false"
                 CommittedItemChanges="@(async viewModel => await CommittedItemChangesAsync(viewModel))"
                 EditMode="DataGridEditMode.Form"
                 EditTrigger="DataGridEditTrigger.Manual"
                 QuickFilter="Filter"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                 StartedEditingItem="StartedEditingItem"
                 SortMode="SortMode.Multiple"
                 Class="mt-4">
        <ToolBarContent>
            <MudTextField T="string" @bind-Value="_searchString"
                          Placeholder="@L["Search"]"
                          Clearable="true" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
        </ToolBarContent>
        <Columns>
            @if (ShowStudents)
            {
                <HierarchyColumn T="UsersListViewModel" ButtonDisabledFunc="@(_ => false)" EnableHeaderToggle="true" />
            }
            <PropertyColumn Property="@(vm => $"{vm.UserFirstName} {vm.UserLastName} {vm.UserNickName} {vm.UserLastName}")" Title="@L["FirstName"]">
                <CellTemplate>
                    <AuditableUserDisplay UsersListViewModel="context.Item"
                                          IsLastNameFirst="_isLastNameFirst"
                                          CurrentUserId="FonbecClaim.UserId" />
                </CellTemplate>
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="@context.Item.UserFirstName" Immediate="true"
                                  Required="true" RequiredError="@L["RequiredField"]"
                                  Label="@L["FirstName"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.FirstName" />
                    <MudTextField T="string" @bind-Value="@context.Item.UserLastName" Immediate="true" Class="mt-4"
                                  Required="true" RequiredError="@L["RequiredField"]"
                                  Label="@L["LastName"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.LastName" />
                </EditTemplate>
            </PropertyColumn>
            @if (ShowStudents)
            {
                <PropertyColumn Property="vm => vm.LinkedStudentCount" Title="@L["Students"]" Editable="false" Filterable="false">
                    <CellTemplate>
                        @context.Item.LinkedStudentCount
                    </CellTemplate>
                    <EditTemplate />
                </PropertyColumn>
            }
            <PropertyColumn Property="vm => vm.UserNickName" Title="@L["Nickname"]" Hidden="true" Required="false">
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="@context.Item.UserNickName" Immediate="true"
                                  Label="@L["Nickname"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.NickName" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="vm => vm.UserGender" Title="@L["Gender"]" Hidden="true">
                <EditTemplate>
                    <MudSelect T="Gender" @bind-Value="context.Item.UserGender" Class="mt-4"
                               Label="@L["Gender"]" Variant="Variant.Outlined" Margin="@Margin.Dense">
                        <MudSelectItem Value="Gender.Male">@L["Male"]</MudSelectItem>
                        <MudSelectItem Value="Gender.Female">@L["Female"]</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="vm => vm.UserEmail" Title="@L["Email"]">
                <CellTemplate>
                    <MudLink Href="@($"mailto:{context.Item.UserEmail}")">
                        @context.Item.UserEmail
                    </MudLink>
                </CellTemplate>
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="context.Item.UserEmail" Immediate="true"
                                  Label="@L["Email"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.Email"
                                  Validation="@(new Func<string, string?>(ValidateEmail))" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="vm => vm.UserPhoneNumber" Title="@L["Phone"]" Required="false">
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="context.Item.UserPhoneNumber" Immediate="true"
                                  Label="@L["Phone"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.FonbecWebUser.PhoneNumber"
                                  Validation="@(new Func<string, string?>(ValidatePhone))" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="vm => vm.UserNotes" Title="@L["AdditionalInformation"]" Required="false" Hidden="true">
                <EditTemplate>
                    <MudTextField T="string" @bind-Value="context.Item.UserNotes" Immediate="true"
                                  Label="@L["AdditionalInformation"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="MaxLength.Auditable.Notes" />
                </EditTemplate>
            </PropertyColumn>
            <TemplateColumn Title="@L["Actions"]" Filterable="false" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="@L["Edit"]" Arrow="true" Placement="Placement.Bottom" Color="Color.Primary" Delay="500">
                        <MudIconButton OnClick="@context.Actions.StartEditingItemAsync"
                                       Icon="@Icons.Material.Outlined.Edit" Size="@Size.Small" Color="Color.Primary" />
                    </MudTooltip>
                    @if (context.Item.IsUserActive)
                    {
                        <MudTooltip Text="@DisableTooltip(context.Item)" Arrow="true" Placement="Placement.Bottom" Color="Color.Warning" Delay="500">
                            <MudIconButton OnClick="@(async _ => await DisableUserAsync(context.Item))"
                                           Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Warning"
                                           Disabled="@(!CanDisable(context.Item))" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@L["Enable"]" Arrow="true" Placement="Placement.Bottom" Color="Color.Success" Delay="500">
                            <MudIconButton OnClick="@(async _ => await ReenableUserAsync(context.Item))"
                                           Icon="@Icons.Material.Outlined.RestoreFromTrash" Size="@Size.Small" Color="Color.Success" />
                        </MudTooltip>
                    }
                    <AuthorizeView Policy="@CustomAccess.ResetPassword" Context="innerContext">
                        <MudTooltip Text="@L["ResetPassword"]" Arrow="true" Placement="Placement.Bottom" Color="Color.Primary" Delay="500">
                            <MudIconButton OnClick="@(async _ => await ResetPasswordAsync(context.Item))"
                                           Icon="@Icons.Material.Outlined.Password" Size="@Size.Small" Color="Color.Primary"
                                           Disabled="@(context.Item.UserId == FonbecClaim.UserId)" />
                        </MudTooltip>
                    </AuthorizeView>
                    @if (ShowDigitalImprovement)
                    {
                        <AuthorizeView Policy="@CustomAccess.ManageDigitalImprovement" Context="innerContext">
                            <MudTooltip Text="@(context.Item.HasDigitalImprovementGrant
                                                  ? L["RemoveImagePermission"]
                                                  : L["GrantImagePermission"])"
                                        Arrow="true" Placement="Placement.Bottom" Color="Color.Primary" Delay="500">
                                <MudToggleIconButton Toggled="context.Item.HasDigitalImprovementGrant"
                                                     ToggledChanged="@(async granted => await SetDigitalImprovementGrantAsync(context.Item, granted))"
                                                     Icon="@Icons.Material.Outlined.AutoFixHigh" Color="Color.Default"
                                                     ToggledIcon="@Icons.Material.Filled.AutoFixHigh" ToggledColor="Color.Primary"
                                                     Size="@Size.Small" ToggledSize="@Size.Small" />
                            </MudTooltip>
                        </AuthorizeView>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            @if (ShowStudents)
            {
                <MudPaper Class="pa-4" Elevation="0">
                    @{
                        var students = StudentChipLabels(context.Item);
                    }
                    @if (students.Count == 0)
                    {
                        <MudText Typo="Typo.body2">@L["NoStudents"]</MudText>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-center gap-1">
                            @foreach (var student in students)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         Icon="@Icons.Material.Filled.Person">
                                    @student
                                </MudChip>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="UsersListViewModel" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfo"]" />
        </PagerContent>
    </MudDataGrid>
}