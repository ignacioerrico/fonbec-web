@attribute [Route(NavRoutes.Admins)]
@attribute [Authorize(Policy = nameof(AdminsList))]
@inherits AuthenticationRequiredComponentBase

<PageHeader Title="Administradores" />

<MudTooltip Text="Alta de administrador"
            Arrow="true" Placement="Placement.Right"
            Color="Color.Primary">
    <MudFab OnClick="AddAdminAsync"
            StartIcon="@Icons.Material.Filled.Add"
            Color="Color.Primary" />
</MudTooltip>

<LoadingIndicator Loading="Loading"
                  If="!_admins.Any()"
                  ThenDisplay="No hay administradores." />

@if (_admins.Any())
{
    <MudStack Spacing="2" Class="mt-4">
        @foreach (var admin in _admins)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body1">
                                <strong>@admin.UserFirstName @admin.UserLastName</strong>
                            </MudText>
                            @if (admin.UserId == FonbecClaim.UserId)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">YO</MudChip>
                            }
                            @if (!admin.IsUserActive)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                                    Deshabilitado
                                </MudChip>
                            }
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(admin.UserEmail))
                        {
                            <MudLink Href="@($"mailto:{admin.UserEmail}")" Typo="Typo.caption">@admin.UserEmail</MudLink>
                        }
                        @if (!string.IsNullOrWhiteSpace(admin.UserPhoneNumber))
                        {
                            <MudText Typo="Typo.caption">@admin.UserPhoneNumber</MudText>
                        }
                    </div>
                    <MudTooltip Text="Administrar" Arrow="true" Placement="Placement.Bottom" Color="Color.Primary">
                        <MudIconButton Href="@NavRoutes.ManageUser(admin.UserId)"
                                       Icon="@Icons.Material.Filled.MoreVert"
                                       aria-label="Administrar"
                                       Size="Size.Small"
                                       Color="Color.Primary" />
                    </MudTooltip>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}