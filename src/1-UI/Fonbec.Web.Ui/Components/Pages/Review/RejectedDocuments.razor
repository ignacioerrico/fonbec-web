@attribute [Route(NavRoutes.RejectedDocuments)]
@attribute [Authorize(Policy = nameof(RejectedDocuments))]
@using Fonbec.Web.Logic.Models.Documents
@using Fonbec.Web.Ui.Components.NonPages.Review
@inherits AuthenticationRequiredComponentBase

<PageHeader Title="Documentos rechazados" />

<LoadingIndicator Loading="Loading" />

@if (!Loading && _page is not null)
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">Pendientes de decisión</MudText>
        @if (_page.Items.Count == 0)
        {
            <MudText Class="mud-text-secondary">No hay documentos esperando una decisión.</MudText>
        }
        else
        {
            <MudDataGrid T="HeldRejectionItemViewModel"
                         Items="_page.Items"
                         Dense="true"
                         Hover="true"
                         Striped="true"
                         Bordered="true"
                         ReadOnly="true"
                         RowsPerPage="10">
                <Columns>
                    <HierarchyColumn T="HeldRejectionItemViewModel" EnableHeaderToggle="true" />
                    <TemplateColumn Title="Tipo de documento" Sortable="false">
                        <CellTemplate>
                            <MudText>@TypeLabel(context.Item)</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="De becario" Sortable="false">
                        <CellTemplate>
                            <MudText>@context.Item.StudentName</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@SponsorColumnHeader" Sortable="false">
                        <CellTemplate>
                            <MudText>@SponsorNames(context.Item)</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Mediador" Sortable="false">
                        <CellTemplate>
                            <MudText>@(string.IsNullOrWhiteSpace(context.Item.FacilitatorName) ? "—" : context.Item.FacilitatorName)</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Acciones" Sortable="false">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudTooltip Text="@ApproveTooltip(context.Item)">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               Disabled="_busyDocumentId is not null"
                                               OnClick="@(() => ShareAsync(context.Item))">
                                        Aprobar
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Le indica al mediador que debe subir un nuevo documento">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="_busyDocumentId is not null"
                                               OnClick="@(() => ReturnAsync(context.Item))">
                                        Rechazar
                                    </MudButton>
                                </MudTooltip>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <ChildRowContent>
                    <MudStack Spacing="3" Class="pa-4">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Rechazado por</MudText>
                                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Item.RejectedByName) ? "—" : context.Item.RejectedByName)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Rechazado el</MudText>
                                <MudText Typo="Typo.body2">@FormatRejectedOn(context.Item)</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Motivo de rechazo</MudText>
                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(context.Item.RejectionReason) ? "—" : context.Item.RejectionReason)</MudText>
                            </MudItem>
                        </MudGrid>
                        <ReviewDocumentViewer DocumentId="context.Item.DocumentId"
                                              FileKind="context.Item.FileKind"
                                              TextContent="@context.Item.TextContent"
                                              YouTubeVideoId="@context.Item.YouTubeVideoId"
                                              Pages="context.Item.Pages"
                                              PageUrlFactory="@(pageNumber => ViewUrl(context.Item, pageNumber))" />
                    </MudStack>
                </ChildRowContent>
                <PagerContent>
                    <MudDataGridPager T="HeldRejectionItemViewModel" RowsPerPageString="Filas por página:" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudPaper>
}
