@using Fonbec.Web.Ui.Account
@using Fonbec.Web.Ui.Account.Shared
@using Fonbec.Web.Ui.Components.Errors
@inject RequestTheme RequestTheme

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <UiErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                        <Authorizing>
                            <MudText Typo="Typo.h6">Verificando permisos&hellip;</MudText>
                        </Authorizing>
                        <NotAuthorized>
                            @{
                                var user = context.User;

                                if (user.Identity is null)
                                {
                                    <RedirectToLogin />
                                }
                                else if (user.Identity.IsAuthenticated)
                                {
                                    <MudText Typo="Typo.h5">No tenés permiso para ver esta página.</MudText>
                                }
                                else
                                {
                                    <RedirectToLogin />
                                }
                            }
                        </NotAuthorized>
                    </AuthorizeRouteView>
                </ChildContent>
                <ErrorContent Context="exception">
                    <MudThemeProvider IsDarkMode="RequestTheme.IsDark" />
                    <MudPopoverProvider />
                    <ErrorFallback ErrorReference="@UiErrorBoundary.ReadReference(exception)" OnRetry="Recover" />
                </ErrorContent>
            </UiErrorBoundary>
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private UiErrorBoundary? _errorBoundary;

    private void Recover() => _errorBoundary?.Recover();
}