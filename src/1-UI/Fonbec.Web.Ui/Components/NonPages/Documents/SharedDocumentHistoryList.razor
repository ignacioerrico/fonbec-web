@using Fonbec.Web.DataAccess.Constants

@if (!_loaded)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-8" />
}
else if (!IsAuthorized)
{
    <PageTitle>Enlace no válido</PageTitle>
    <MudText Typo="Typo.h5" Class="mb-4">Este enlace no es válido.</MudText>
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        No se pudo abrir el historial de documentos. Si creés que esto es un error, contactá a FONBEC.
    </MudAlert>
}
else
{
    <PageTitle>Documentos de @StudentDisplayName</PageTitle>
    <MudText Typo="Typo.h5">
        Documentos enviados por <strong>@StudentDisplayName</strong> para @RecipientDisplayName
    </MudText>
    @if (CcRecipientLine is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2">@CcRecipientLine</MudText>
    }
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-6">
        Este enlace es personal: no lo compartas. Guardalo en favoritos para volver cuando quieras.
    </MudText>

    <div class="recipient-thread">
        @if (_threadItems.Count == 0)
        {
            <MudText Typo="Typo.body1">Todavía no hay cartas ni mensajes.</MudText>
        }
        else
        {
            @if (_hasOlder)
            {
                <div class="d-flex justify-center">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="_loadingOlder"
                               OnClick="LoadOlderAsync">
                        @(_loadingOlder ? "Cargando…" : "Cargar anteriores")
                    </MudButton>
                </div>
            }

            @foreach (var item in _threadItems)
            {
                if (item.IsMessage)
                {
                    <div class="recipient-thread__item recipient-thread__item--outgoing" @key="@($"m{item.RecipientMessageId}")">
                        <div class="recipient-thread__bubble">
                            <div class="recipient-thread__body">@item.Body</div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">@item.SentOnLabel</MudText>
                            <MudText Typo="Typo.caption" Class="recipient-thread__status">@item.StatusLabel</MudText>
                        </div>
                    </div>
                }
                else if (item.Letter is not null)
                {
                    var letter = item.Letter;
                    var expanded = _expandedDocumentIds.Contains(letter.DocumentId);
                    <div class="recipient-thread__item recipient-thread__item--incoming" @key="@($"d{letter.DocumentId}")">
                        <SharedDocumentHistoryEntry Document="letter"
                                                    Expanded="expanded"
                                                    PageUrl="@(page => DownloadUrl(letter.DocumentId, page))"
                                                    OnToggle="@(() => ToggleExpanded(letter.DocumentId))" />
                    </div>
                }
            }
        }
    </div>

    <div class="recipient-composer">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            El mediador le va a hacer llegar este mensaje al becario. No llega de forma inmediata.
        </MudText>
        <MudTextField @bind-Value="_draft"
                      T="string"
                      Label="@MessageLabel"
                      Variant="Variant.Outlined"
                      Lines="3"
                      MaxLength="@MaxLength.RecipientMessage.Body"
                      Immediate="true"
                      Disabled="_sending"
                      AutoGrow="true"
                      MaxLines="8" />
        @if (_sendError is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_sendError</MudText>
        }
        <div class="d-flex justify-end mt-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!CanSend)"
                       OnClick="SendAsync">
                Enviar
            </MudButton>
        </div>
    </div>

    @if (_documents.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-8 mb-2">Otros documentos</MudText>

        @foreach (var year in DocumentsByYear())
        {
            @if (ShowYearHeadings)
            {
                <MudText Typo="Typo.subtitle2" Class="public-history-year">@year.Key</MudText>
            }

            @foreach (var doc in year)
            {
                @if (ShouldShowDividerBefore(doc))
                {
                    <div class="public-history-divider" role="separator" aria-label="Documentos ya vistos">
                        <MudText Typo="Typo.caption" Class="public-history-divider__label">Documentos ya vistos</MudText>
                        <MudDivider />
                    </div>
                }

                var expanded = _expandedDocumentIds.Contains(doc.DocumentId);
                <SharedDocumentHistoryEntry @key="doc.DocumentId"
                                            Document="doc"
                                            Expanded="expanded"
                                            ShowNewChip="IsNewSinceLastVisit(doc)"
                                            RowClass="@(IsLastNewDocument(doc) ? "public-history-row--before-seen" : null)"
                                            PageUrl="@(page => DownloadUrl(doc.DocumentId, page))"
                                            OnToggle="@(() => ToggleExpanded(doc.DocumentId))" />
            }
        }

        @if (_hasMore)
        {
            <div class="d-flex justify-center mt-6">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="_loadingMore"
                           OnClick="LoadMoreAsync">
                    @(_loadingMore ? "Cargando…" : "Cargar más")
                </MudButton>
            </div>
        }
    }
}