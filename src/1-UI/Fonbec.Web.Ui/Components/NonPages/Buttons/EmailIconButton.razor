@if (!string.IsNullOrWhiteSpace(EmailAddress))
{
    <MudTooltip Text="@EmailAddress" Arrow="true" Placement="Placement.Bottom">
        <MudIconButton Href="@($"mailto:{EmailAddress}")"
                       Icon="@Icons.Material.Outlined.Email"
                       Size="Size.Small"
                       aria-label="@($"Enviar correo a {EmailAddress}")" />
    </MudTooltip>
}

@code {
    [Parameter]
    public string? EmailAddress { get; set; }
}