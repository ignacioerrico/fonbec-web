@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
@if (Loading)
{
    <MudText Class="mt-4">
        <em>@LoadingText&hellip;</em>
    </MudText>

    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}

@if (If)
{
    <MudText Typo="Typo.h6" Class="mt-4">@ThenDisplay</MudText>
}