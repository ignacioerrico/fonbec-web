@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
@using Fonbec.Web.DataAccess.Constants

<MudSelect T="string" Label="@L["Role"]"
           Value="SelectedRole" ValueChanged="OnSelectedValueChanged"
           Required="true" RequiredError="@L["Required"]"
           Variant="Variant.Filled" AnchorOrigin="Origin.BottomLeft">
    @foreach (var role in FonbecRole.AllRoles)
    {
        <MudSelectItem Value="@role">@L[$"Role.{role}"]</MudSelectItem>
    }
</MudSelect>