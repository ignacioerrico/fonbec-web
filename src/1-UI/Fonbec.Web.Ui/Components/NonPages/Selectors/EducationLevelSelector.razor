@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
@using Fonbec.Web.DataAccess.Entities.Enums
@using Fonbec.Web.Ui.Models

<MudSelect T="EducationLevel" Label="@L["EducationLevel"]"
           Value="_selectedLevel"
           ValueChanged="OnSelectedLevelChanged"
           Required="true" RequiredError="@L["SelectEducationLevel"]"
           Variant="Variant.Filled" AnchorOrigin="Origin.BottomLeft">
    <MudSelectItem T="EducationLevel" Value="EducationLevel.PrimarySchool">@L["Primary"]</MudSelectItem>
    <MudSelectItem T="EducationLevel" Value="EducationLevel.SecondarySchool">@L["Secondary"]</MudSelectItem>
    <MudSelectItem T="EducationLevel" Value="EducationLevel.University">@L["University"]</MudSelectItem>
</MudSelect>

@if (_selectedLevel is EducationLevel.PrimarySchool)
{
    <MudCheckBox T="bool" Label="@L["KnowSecondaryStart"]"
                 Value="_isSecondarySchoolStartYearKnown"
                 ValueChanged="OnIsSecondarySchoolStartYearKnownChanged" />

    @if (_isSecondarySchoolStartYearKnown)
    {
        <MudNumericField T="int?" Label="@L["SecondaryStart"]"
                         Required="_isSecondarySchoolStartYearKnown" RequiredError="@L["KnownYearRequired"]"
                         Value="SecondarySchoolStartYear?.Year"
                         ValueChanged="OnSecondarySchoolStartYearChanged"
                         Min="_currentYear" Max="@(_currentYear + 30)" />
    }
}

@if ((_selectedLevel is EducationLevel.PrimarySchool && _isSecondarySchoolStartYearKnown && SecondarySchoolStartYear.HasValue)
     || _selectedLevel is EducationLevel.SecondarySchool)
{
    <MudCheckBox T="bool" Label="@L["KnowUniversityStart"]"
                 Value="_isUniversityStartYearKnown"
                 ValueChanged="OnIsUniversityStartYearKnownChanged" />

    @if (_isUniversityStartYearKnown)
    {
        <MudNumericField T="int?" Label="@L["UniversityStart"]"
                         Required="_isUniversityStartYearKnown" RequiredError="@L["KnownYearRequired"]"
                         Value="UniversityStartYear?.Year"
                         ValueChanged="OnUniversityStartYearChanged"
                         Min="_currentYear" Max="@(_currentYear + 30)" />
    }
}