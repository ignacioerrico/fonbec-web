@using Fonbec.Web.DataAccess.Entities.Enums
@inject IStringLocalizer<SharedResources> L

<MudSelect T="Gender" Label="@L["Gender"]"
           Value="SelectedGender"
           ValueChanged="OnSelectedValueChanged"
           Variant="Variant.Filled" AnchorOrigin="Origin.BottomLeft">
	<MudSelectItem T="Gender" Value="Gender.Male">@L["Male"]</MudSelectItem>
	<MudSelectItem T="Gender" Value="Gender.Female">@L["Female"]</MudSelectItem>
</MudSelect>
