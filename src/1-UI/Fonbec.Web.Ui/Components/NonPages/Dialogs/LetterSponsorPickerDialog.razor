@using Fonbec.Web.Logic.Models.Students

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Subir carta — @StudentFullName</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Plan: @PlanLabel</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Seleccioná el padrino para esta carta:</MudText>

        <MudRadioGroup T="int?" @bind-Value="_selectedSponsorshipId">
            @foreach (var sponsor in Sponsors)
            {
                <MudRadio T="int?" Value="@((int?)sponsor.SponsorshipId)" Class="@(sponsor.Status == LetterSlotStatus.Approved ? "mud-text-secondary" : null)">
                    <div class="d-flex align-center gap-2">
                        <span class="flex-grow-1">@sponsor.RecipientName</span>
                        <MudIcon Icon="@sponsor.Status.Icon()" Color="@sponsor.Status.Color()" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@sponsor.Status.Label()</MudText>
                    </div>
                </MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_selectedSponsorshipId is null)"
                   OnClick="Continue">
            Continuar
        </MudButton>
    </DialogActions>
</MudDialog>
