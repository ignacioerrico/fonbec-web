@using Fonbec.Web.Logic.Models.Facilitators
@using Fonbec.Web.Logic.Models.Students
@using Fonbec.Web.Ui.Components.NonPages.Letters

<MudDialog>
    <DialogContent>
        @if (Student.LetterAggregate is LetterAggregateStatus.Exempt or LetterAggregateStatus.NoPlan)
        {
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">Padrinos (@Student.Sponsors.Count)</MudText>
                    </MudStack>
                    @foreach (var sponsor in Student.Sponsors)
                    {
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@(sponsor.IsCompany ? Icons.Material.Filled.Factory : Icons.Material.Filled.Person)" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@sponsor.RecipientName</MudText>
                        </div>
                    }
                </MudStack>
                <MudStack Spacing="1">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Mail" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">Carta</MudText>
                    </MudStack>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Student.LetterAggregate.Icon()" Color="@Student.LetterAggregate.Color()" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@LetterDetailText</MudText>
                    </div>
                </MudStack>
            </MudStack>
        }
        else
        {
            <SponsorLetterStatusList Sponsors="@Student.LetterStatuses" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Cerrar</MudButton>
    </DialogActions>
</MudDialog>