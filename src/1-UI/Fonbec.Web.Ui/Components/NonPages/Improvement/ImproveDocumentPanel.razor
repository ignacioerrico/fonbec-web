<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Versión mejorada</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Por cada página, presioná «Usar original» si la imagen ya se ve bien, editala acá, o subí una versión mejorada como JPG.
    </MudText>

    <MudStack Spacing="3">
        @for (var i = 0; i < PageCount; i++)
        {
            var pageIndex = i;
            var pageNumber = i + 1;
            var page = _pages[pageIndex];
            <MudPaper Class="pa-3" Outlined="true" Style="cursor: pointer;"
                      @onclick="@(() => FocusPageAsync(pageNumber))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="2">
                    <MudText Typo="Typo.subtitle2">Pág. @pageNumber</MudText>
                    <MudSpacer />
                    @if (page is not null)
                    {
                        <MudText Typo="Typo.body2">@(page.Name) (@FormatBytes(page.Size))</MudText>
                        <div @onclick:stopPropagation="true">
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Disabled="ActionsDisabled"
                                       OnClick="@(() => ClearPageAsync(pageIndex))">
                                Usar original
                            </MudButton>
                        </div>
                        <div @onclick:stopPropagation="true">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Disabled="ActionsDisabled"
                                       OnClick="@(() => EditPageAsync(pageIndex))">
                                Editar
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                            Usar original
                        </MudChip>
                        <div @onclick:stopPropagation="true">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Disabled="ActionsDisabled"
                                       OnClick="@(() => EditPageAsync(pageIndex))">
                                Editar
                            </MudButton>
                        </div>
                        <div @onclick:stopPropagation="true">
                            <MudFileUpload T="IBrowserFile"
                                           Accept=".jpg,.jpeg"
                                           Disabled="ActionsDisabled"
                                           FilesChanged="selected => OnPageFileSelected(pageIndex, selected)">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.UploadFile"
                                               Disabled="ActionsDisabled">
                                        Subir JPG
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                        </div>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>

    @if (FirstValidationError() is { } validationError)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4" Variant="Variant.Text">
            @validationError
        </MudAlert>
    }

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="mt-4 flex-wrap">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.LockOpen"
                   Disabled="ActionsDisabled"
                   OnClick="ReleaseClickedAsync">
            Liberar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@(HasAnyUpload ? Icons.Material.Filled.CloudUpload : Icons.Material.Filled.Check)"
                   Disabled="SubmitDisabled"
                   OnClick="SubmitAsync">
            @(HasAnyUpload ? "Subir" : "Está bien así")
        </MudButton>
    </MudStack>
</MudPaper>

<LoadingIndicator Loading="_saving" LoadingText="@(HasAnyUpload ? "Subiendo las imágenes mejoradas" : "Guardando")" />