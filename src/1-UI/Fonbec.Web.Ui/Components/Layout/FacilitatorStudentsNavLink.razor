@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
<MudNavLink Href="@NavRoutes.FacilitatorStudents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Face">
    <span class="nav-count">
        <span class="nav-count__label">@L["MyStudents"]</span>
        @if (_badge is not null)
        {
            <span class="nav-count__badge">@_badge</span>
        }
    </span>
</MudNavLink>