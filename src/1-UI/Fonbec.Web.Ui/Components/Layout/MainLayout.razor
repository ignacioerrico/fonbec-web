@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider IsDarkMode="_isDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
        <span class="fonbec-brand fonbec-brand--app-bar ml-3">
            FONBEC <span class="fonbec-brand-accent">Web</span>
        </span>
        <MudSpacer />
        <AuthorizeView>
            @{
                var chapterName = context.User.FindFirst(FonbecWebUserCustomClaim.ChapterName)?.Value
                                  ?? "GLOBAL";
            }
            <MudIcon Icon="@Icons.Material.Filled.Place" />
            <MudText Typo="Typo.h6" Class="ml-1">@chapterName</MudText>
        </AuthorizeView>
        <MudSpacer />
        <AuthorizeView>
            <MudMenu Dense="true"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     AriaLabel="@L["Information"]">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Info"
                                   Color="Color.Inherit"
                                   title="@L["Information"]"
                                   aria-label="@L["Information"]" />
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="@NavRoutes.About">@L["About"]</MudMenuItem>
                    <MudMenuItem Href="@NavRoutes.Privacy">@L["Privacy"]</MudMenuItem>
                    <MudMenuItem Href="@NavRoutes.DataDeletion">@L["DataDeletion"]</MudMenuItem>
                </ChildContent>
            </MudMenu>
            <MudTooltip Text="@ThemeTooltip">
                @if (IsStaticRender)
                {
                    <form method="post" action="Account/Theme" class="d-inline-flex">
                        <AntiforgeryToken />
                        <input type="hidden" name="isDark" value="@NextIsDarkValue" />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        <MudIconButton id="theme-toggle"
                                       Icon="@ThemeIcon"
                                       Color="Color.Inherit"
                                       title="@ThemeTooltip"
                                       aria-label="@ThemeTooltip"
                                       ButtonType="ButtonType.Submit"
                                       Class="ml-2" />
                    </form>
                }
                else
                {
                    <MudIconButton id="theme-toggle"
                                   Icon="@ThemeIcon"
                                   Color="Color.Inherit"
                                   title="@ThemeTooltip"
                                   aria-label="@ThemeTooltip"
                                   OnClick="ToggleThemeAsync"
                                   Class="ml-2" />
                }
            </MudTooltip>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer id="nav-drawer" Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4 fonbec-main-content">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @L["UnexpectedError"]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>