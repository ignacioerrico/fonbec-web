@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.Ui.Components.Pages.Chapters
@using Fonbec.Web.Ui.Components.Pages.Companies
@using Fonbec.Web.Ui.Components.Pages.PlannedDeliveries
@using Fonbec.Web.Ui.Components.Pages.Sponsors
@using Fonbec.Web.Ui.Components.Pages.Facilitators
@using Fonbec.Web.Ui.Components.Pages.Students
@using Fonbec.Web.Ui.Components.Pages.Users
@using System.Security.Claims

<MudNavMenu Class="d-flex flex-column" Style="height: 100%;">
    <div class="flex-grow-1">
        <AuthorizeView Context="outerContext">
            <Authorized>
                <MudText Typo="Typo.h6" Class="px-4 pt-2">
                    @{
                        var role = outerContext.User.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
                        FonbecRole.Translator.TryGetValue(role, out var translatedRole);
                    }
                    @translatedRole
                </MudText>

                <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">
                    @outerContext.User.Identity?.Name
                </MudText>

                <MudDivider Class="my-2" />

                <AuthorizeView Policy="@nameof(ChaptersList)">
                    <MudNavLink Href="@NavRoutes.Chapters" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Place">
                        Filiales
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(UsersList)">
                    <MudNavLink Href="@NavRoutes.Users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBox">
                        Usuarios
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(StudentsList)">
                    <MudNavLink Href="@NavRoutes.Students" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Face">
                        Becarios
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(SponsorsList)">
                    <MudNavLink Href="@NavRoutes.Sponsors" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupervisorAccount">
                        Padrinos
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(CompaniesList)">
                    <MudNavLink Href="@NavRoutes.Companies" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Factory">
                        Empresas
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(PlannedDeliveriesList)">
                    <MudNavLink Href="@NavRoutes.PlannedDeliveries" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MailOutline">
                        Cartas
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(FacilitatorStudentsList)">
                    <MudNavLink Href="@NavRoutes.FacilitatorStudents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Face">
                        Mis becarios
                    </MudNavLink>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </div>

    <AuthorizeView Context="outerContext">
        <Authorized>
            <div>
                <MudDivider Class="my-2" />

                <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                    Configuración
                </MudNavLink>

                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="Account/Login" />
                    <button type="submit" class="mud-nav-link mud-ripple">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Cerrar sesión
                    </button>
                </form>
            </div>
        </Authorized>

        <NotAuthorized>
            <MudNavLink Href="/Account/Login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Password">
                Ingresar
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>