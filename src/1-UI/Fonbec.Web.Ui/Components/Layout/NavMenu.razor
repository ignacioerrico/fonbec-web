@using Fonbec.Web.DataAccess.Constants
@using Fonbec.Web.Logic.Constants
@using Fonbec.Web.Ui.Components.Pages.Chapters
@using Fonbec.Web.Ui.Components.Pages.Companies
@using Fonbec.Web.Ui.Components.Pages.LetterFollowUp
@using Fonbec.Web.Ui.Components.Pages.PlannedDeliveries
@using Fonbec.Web.Ui.Components.Pages.Review
@using Fonbec.Web.Ui.Components.Pages.Sponsors
@using Fonbec.Web.Ui.Components.Pages.Facilitators
@using Fonbec.Web.Ui.Components.Pages.StudentMessages
@using Fonbec.Web.Ui.Components.Pages.Students
@using Fonbec.Web.Ui.Components.Pages.Users
@using Fonbec.Web.Logic.Models.Navigation
@using Fonbec.Web.Logic.Models.RecipientMessages
@using System.Security.Claims

<MudNavMenu Class="d-flex flex-column" Style="height: 100%;">
    <div class="flex-grow-1" data-enhance-nav="@EnhancedNav">
        <AuthorizeView Context="outerContext">
            <Authorized>
                <MudText Typo="Typo.h6" Class="px-4 pt-2">
                    @{
                        var role = outerContext.User.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
                        FonbecRole.Translator.TryGetValue(role, out var translatedRole);
                    }
                    @translatedRole
                </MudText>

                <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">
                    @outerContext.User.Identity?.Name
                </MudText>

                <MudDivider Class="my-2" />

                <AuthorizeView Policy="@nameof(ChaptersList)">
                    <MudNavLink Href="@NavRoutes.Chapters" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Place">
                        Filiales
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(UsersList)">
                    <MudNavGroup Title="Usuarios" Icon="@Icons.Material.Filled.AccountBox" Expanded="true">
                        <MudNavLink Href="@NavRoutes.Users" Match="NavLinkMatch.Prefix">
                            Usuarios
                        </MudNavLink>
                    </MudNavGroup>
                </AuthorizeView>

                <AuthorizeView Roles="@($"{FonbecRole.Admin},{FonbecRole.Manager}")" Context="sponsorshipsContext">
                    <MudNavGroup Title="Apadrinamientos" Icon="@Icons.Material.Filled.Handshake" Expanded="true">
                        <AuthorizeView Policy="@nameof(StudentsList)" Context="studentsContext">
                            <MudNavLink Href="@NavRoutes.Students" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Becarios</span>
                                    @if (_indicators.StudentCount is int students)
                                    {
                                        <span class="nav-count__note">@NavMenuFormatting.CountNote(students)</span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>

                        <AuthorizeView Policy="@nameof(SponsorsList)" Context="sponsorsContext">
                            <MudNavLink Href="@NavRoutes.Sponsors" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Padrinos</span>
                                    @if (_indicators.SponsorCount is int sponsors)
                                    {
                                        <span class="nav-count__note">@NavMenuFormatting.CountNote(sponsors)</span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>

                        <AuthorizeView Policy="@nameof(CompaniesList)" Context="companiesContext">
                            <MudNavLink Href="@NavRoutes.Companies" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Empresas</span>
                                    @if (_indicators.CompanyCount is int companies)
                                    {
                                        <span class="nav-count__note">@NavMenuFormatting.CountNote(companies)</span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>
                    </MudNavGroup>
                </AuthorizeView>

                <AuthorizeView Policy="@nameof(FacilitatorStudentsList)">
                    <FacilitatorStudentsNavLink />
                </AuthorizeView>

                <AuthorizeView Roles="@($"{FonbecRole.Manager},{FonbecRole.Uploader}")" Context="lettersContext">
                    <MudNavGroup Title="Cartas" Icon="@Icons.Material.Filled.MailOutline" Expanded="true">
                        <AuthorizeView Policy="@nameof(PlannedDeliveriesList)" Context="plannedDeliveriesContext">
                            <MudNavLink Href="@NavRoutes.PlannedDeliveries" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Campañas</span>
                                    @if (_indicators.CampaignCompletionPercent is int percent)
                                    {
                                        <span class="nav-count__note" title="Avance de la campaña activa">@NavMenuFormatting.PercentNote(percent)</span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@nameof(LetterFollowUp)" Context="letterFollowUpContext">
                            <MudNavLink Href="@NavRoutes.LetterFollowUp" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Seguimiento</span>
                                    @if (_indicators.RedFlags > 0 || _indicators.GreenFlags > 0)
                                    {
                                        <span class="nav-count__badges">
                                            @if (_indicators.RedFlags > 0)
                                            {
                                                <span class="nav-count__badge"
                                                      title="@NavMenuFormatting.RedFlags(_indicators.RedFlags)"
                                                      aria-label="@NavMenuFormatting.RedFlags(_indicators.RedFlags)">@_indicators.RedFlags</span>
                                            }
                                            @if (_indicators.GreenFlags > 0)
                                            {
                                                <span class="nav-count__badge nav-count__badge--success"
                                                      title="@NavMenuFormatting.GreenFlags(_indicators.GreenFlags)"
                                                      aria-label="@NavMenuFormatting.GreenFlags(_indicators.GreenFlags)">@_indicators.GreenFlags</span>
                                            }
                                        </span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@nameof(StudentMessages)" Context="studentMessagesContext">
                            <StudentMessagesNavLink />
                        </AuthorizeView>
                    </MudNavGroup>
                </AuthorizeView>

                <AuthorizeView Roles="@($"{FonbecRole.Reviewer},{FonbecRole.Manager}")" Context="reviewContext">
                    <MudNavGroup Title="Revisión" Icon="@Icons.Material.Filled.RateReview" Expanded="true">
                        <AuthorizeView Policy="@DocumentPermission.DigitalImprovement" Context="improvementContext">
                            <MudNavLink Href="@NavRoutes.ImprovementQueue" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Mejorar imágenes</span>
                                    @if (_indicators.PendingImprovement is int pendingImprovement
                                         && PendingMessageBadge.Format(pendingImprovement) is string improvementBadge)
                                    {
                                        <span class="nav-count__badge"
                                              title="@NavMenuFormatting.PendingChanges(pendingImprovement)"
                                              aria-label="@NavMenuFormatting.PendingChanges(pendingImprovement)">@improvementBadge</span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>

                        <AuthorizeView Policy="@nameof(ReviewQueue)" Context="reviewQueueContext">
                            <MudNavLink Href="@NavRoutes.ReviewQueue" Match="NavLinkMatch.Prefix">
                                <span class="nav-count">
                                    <span class="nav-count__label">Revisar documentos</span>
                                    @if (_indicators.PendingReview is int pendingReview
                                         && PendingMessageBadge.Format(pendingReview) is string reviewBadge)
                                    {
                                        <span class="nav-count__badge"
                                              title="@NavMenuFormatting.PendingChanges(pendingReview)"
                                              aria-label="@NavMenuFormatting.PendingChanges(pendingReview)">@reviewBadge</span>
                                    }
                                </span>
                            </MudNavLink>
                        </AuthorizeView>
                    </MudNavGroup>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </div>

    <AuthorizeView Context="outerContext">
        <Authorized>
            <div data-enhance-nav="@EnhancedNav">
                <MudDivider Class="my-2" />

                <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                    Configuración
                </MudNavLink>

                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="Account/Login" />
                    <button type="submit" class="mud-nav-link mud-ripple">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Cerrar sesión
                    </button>
                </form>
            </div>
        </Authorized>

        <NotAuthorized>
            <MudNavLink Href="/Account/Login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Password">
                Ingresar
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>
