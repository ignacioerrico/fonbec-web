@page "/Account/ExternalLogin"

@using Fonbec.Web.DataAccess.Entities
@using Fonbec.Web.Ui.Account
@using Microsoft.AspNetCore.Identity

@inject SignInManager<FonbecWebUser> SignInManager
@inject UserManager<FonbecWebUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

<PageTitle>Iniciar sesión</PageTitle>

<MudText Typo="Typo.body1" Align="Align.Center">Redirigiendo…</MudText>

@code {
    public const string LoginCallbackAction = "LoginCallback";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            Logger.LogWarning("External login failed with remote error {RemoteError}.", RemoteError);
            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                ExternalLoginCopy.RemoteErrorMessage(RemoteError),
                HttpContext);
        }

        if (!HttpMethods.IsGet(HttpContext.Request.Method) || Action != LoginCallbackAction)
        {
            RedirectManager.RedirectTo("Account/Login");
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", ExternalLoginCopy.LoadFailed, HttpContext);
        }

        await CompleteLoginAsync(info);
    }

    private async Task CompleteLoginAsync(ExternalLoginInfo info)
    {
        var result = await SignInManager.ExternalLoginSignInAsync(
            info.LoginProvider,
            info.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        var email = ExternalLoginPolicy.ReadEmail(info.Principal);
        FonbecWebUser? user = null;
        if (!result.Succeeded && !result.IsLockedOut && !result.IsNotAllowed && email is not null)
        {
            user = await UserManager.FindByEmailAsync(email);
        }

        var userLockedOut = user is not null && await UserManager.IsLockedOutAsync(user);
        var decision = ExternalLoginPolicy.Decide(
            alreadySignedIn: result.Succeeded,
            alreadyLinkedAndLockedOut: result.IsLockedOut,
            alreadyLinkedAndNotAllowed: result.IsNotAllowed,
            matchingUserExists: user is not null,
            matchingUserLockedOut: userLockedOut);

        switch (decision)
        {
            case ExternalLoginDecision.SignIn:
                Logger.LogInformation("User signed in with {LoginProvider}.", info.LoginProvider);
                RedirectManager.RedirectTo(ReturnUrl);
                break;
            case ExternalLoginDecision.Lockout:
                Logger.LogWarning("External sign-in denied because the account is locked out.");
                RedirectManager.RedirectTo("Account/Lockout");
                break;
            case ExternalLoginDecision.NotAllowed:
                RedirectManager.RedirectToWithStatus("Account/Login", ExternalLoginCopy.NotAllowed, HttpContext);
                break;
            case ExternalLoginDecision.NotProvisioned:
                Logger.LogInformation("External sign-in denied because no matching FONBEC user exists.");
                RedirectManager.RedirectToWithStatus("Account/Login", ExternalLoginCopy.NotProvisioned, HttpContext);
                break;
            case ExternalLoginDecision.LinkAndSignIn:
                if (user is null)
                {
                    RedirectManager.RedirectToWithStatus("Account/Login", ExternalLoginCopy.NotProvisioned, HttpContext);
                }

                await LinkAndSignInAsync(user, info);
                break;
        }
    }

    private async Task LinkAndSignInAsync(FonbecWebUser user, ExternalLoginInfo info)
    {
        if (await UserManager.IsLockedOutAsync(user))
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }

        var addLogin = await UserManager.AddLoginAsync(user, info);
        if (!addLogin.Succeeded)
        {
            Logger.LogWarning(
                "Could not link {LoginProvider} for user {UserId}: {Errors}",
                info.LoginProvider,
                user.Id,
                string.Join(", ", addLogin.Errors.Select(error => error.Description)));
            RedirectManager.RedirectToWithStatus("Account/Login", ExternalLoginCopy.LinkFailed, HttpContext);
        }

        await SignInManager.SignInAsync(user, isPersistent: false, info.LoginProvider);
        Logger.LogInformation(
            "Linked {LoginProvider} and signed in user {UserId}.",
            info.LoginProvider,
            user.Id);
        RedirectManager.RedirectTo(ReturnUrl);
    }
}
