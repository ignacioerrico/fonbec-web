@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Fonbec.Web.DataAccess.Entities
@using Microsoft.AspNetCore.Identity

@inject UserManager<FonbecWebUser> UserManager
@inject SignInManager<FonbecWebUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Eliminar datos personales</PageTitle>

<MudText Typo="Typo.h6" GutterBottom="true">Eliminar datos personales</MudText>

<StatusMessage Message="@_message" />

<MudAlert Severity="Severity.Error" Variant="Variant.Text">
    Eliminar estos datos va a remover permanentemente tu cuenta, y esto no se puede recuperar.
</MudAlert>

<EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />

    <MudGrid>
        @if (_requirePassword)
        {
            <MudItem md="12">
                <MudStaticTextField For="@(() => Input.Password)" @bind-Value="Input.Password"
                                    Label="Contraseña" Placeholder="contraseña" HelperText="Ingresá tu contraseña."
                                    InputType="InputType.Password"
                                    Adornment="Adornment.End"
                                    AdornmentIcon="@Icons.Material.Outlined.Visibility"
                                    AdornmentToggledIcon="@Icons.Material.Outlined.VisibilityOff"
                                    AdornmentClickFunction="togglePasswordVisibility"
                                    UserAttributes="@(new() { { "autocomplete", "current-password" }, { "aria-required", "true" } })" />
            </MudItem>
        }
        <MudItem md="12">
            <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" FormAction="FormAction.Submit">Eliminar datos y cerrar mi cuenta</MudStaticButton>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private string? _message;
    private FonbecWebUser _user = null!;
    private bool _requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = null!;

    protected override void OnParametersSet()
    {
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _requirePassword = await UserManager.HasPasswordAsync(_user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input is null)
        {
            return;
        }

        if (_requirePassword && !await UserManager.CheckPasswordAsync(_user, Input.Password))
        {
            _message = "Error: Contraseña incorrecta.";
            return;
        }

        var result = await UserManager.DeleteAsync(_user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred deleting user.");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(_user);
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        [Display(Name = "Contraseña")]
        public string Password { get; set; } = "";
    }
}
