@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Datos personales</PageTitle>

<MudText Typo="Typo.h6" GutterBottom="true">Datos personales</MudText>

<StatusMessage />

<MudGrid>
    <MudItem md="12">
        <MudText Typo="Typo.body1">
            Tu cuenta contiene datos personales que nos diste. Esta página te permite descargarlos o eliminarlos.
        </MudText>
    </MudItem>
    <MudItem md="12">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text">
            Eliminar estos datos va a remover permanentemente tu cuenta, y esto no se puede recuperar.
        </MudAlert>
    </MudItem>
    <MudItem md="12">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" FormAction="FormAction.Submit">Descargar</MudStaticButton>
        </form>
    </MudItem>
    <MudItem md="12">
        <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" Href="Account/Manage/DeletePersonalData">Eliminar</MudButton>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
