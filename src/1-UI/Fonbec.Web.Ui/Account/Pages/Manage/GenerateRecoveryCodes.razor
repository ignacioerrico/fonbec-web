@page "/Account/Manage/GenerateRecoveryCodes"

@using Fonbec.Web.DataAccess.Entities
@using Microsoft.AspNetCore.Identity

@inject UserManager<FonbecWebUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Generar códigos de recuperación de autenticación en dos pasos (2FA)</PageTitle>

@if (_recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="_recoveryCodes.ToArray()" StatusMessage="@_message" />
}
else
{
    <h3>Generar códigos de recuperación de autenticación en dos pasos (2FA)</h3>
    <div class="alert alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>Guardá estos códigos en un lugar seguro.</strong>
        </p>
        <p>
            Si perdés tu dispositivo y no tenés los códigos de recuperación, vas a perder el acceso a tu cuenta.
        </p>
        <p>
            Generar nuevos códigos de recuperación no cambia las claves usadas en las apps de autenticación. Si querés cambiar la clave
            usada en una app de autenticación, deberías <a href="Account/Manage/ResetAuthenticator">restablecer tus claves de autenticación.</a>
        </p>
    </div>
    <div>
        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Generar códigos de recuperación</button>
        </form>
    </div>
}

@code {
    private string? _message;
    private FonbecWebUser _user = null!;
    private IEnumerable<string>? _recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(_user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Cannot generate recovery codes for user because they do not have 2FA enabled.");
        }
    }

    private async Task OnSubmitAsync()
    {
        var userId = await UserManager.GetUserIdAsync(_user);
        _recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(_user, 10);
        _message = "Generaste nuevos códigos de recuperación.";

        Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
    }
}
