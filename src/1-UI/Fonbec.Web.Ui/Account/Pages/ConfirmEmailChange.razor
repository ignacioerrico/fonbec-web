@page "/Account/ConfirmEmailChange"

@using System.Text
@using Fonbec.Web.DataAccess.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<FonbecWebUser> UserManager
@inject SignInManager<FonbecWebUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirmar cambio de correo</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">Confirmar cambio de correo</MudText>

<StatusMessage Message="@_message" Class="mt-4" />

<div class="auth-layout__links mt-6">
    <MudButton Href="Account/Login"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text"
               Color="Color.Default">
        Volver al inicio de sesión
    </MudButton>
</div>

@code {
    private string? _message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Error: Enlace de confirmación de cambio de correo inválido.", HttpContext);
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            _message = $"No se pudo encontrar el usuario con Id '{UserId}'";
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            _message = "Error al cambiar el correo.";
            return;
        }

        // In our UI email and user name are one and the same, so when we update the email
        // we need to update the user name.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            _message = "Error al cambiar el nombre de usuario.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        _message = "Gracias por confirmar el cambio de correo.";
    }
}
