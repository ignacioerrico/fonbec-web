@page "/Account/ForgotPasswordConfirmation"
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["EmailSent"]</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">@L["CheckEmail"]</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6 mud-text-secondary">
    @L["RecoveryConfirmation"]
</MudText>

<div class="auth-layout__links">
    <MudButton Href="Account/Login"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text"
               Color="Color.Default">
        @L["BackToSignIn"]
    </MudButton>
</div>
