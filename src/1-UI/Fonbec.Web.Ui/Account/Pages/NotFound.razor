@page "/not-found"

@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

<PageTitle>No encontrado</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">No se encontró la página</MudText>

<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
    Lo que estás buscando no está.
    <strong>Por favor, reportá el error.</strong>
</MudAlert>

<div class="auth-layout__links mt-6">
    <MudLink Href="">Ir al inicio</MudLink>
</div>
