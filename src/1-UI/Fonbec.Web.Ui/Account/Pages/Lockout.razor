@inject Microsoft.Extensions.Localization.IStringLocalizer<Fonbec.Web.Ui.Localization.SharedResources> L
@page "/Account/Lockout"

<PageTitle>@L["AccountLocked"]</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">@L["AccountLocked"]</MudText>
<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
    @L["AccountLockedIntro"]
</MudAlert>

<div class="auth-layout__links mt-6">
    <MudButton Href="Account/Login"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text"
               Color="Color.Default">
        @L["BackToSignIn"]
    </MudButton>
</div>
