@page "/Account/RegisterConfirmation"

@using Fonbec.Web.DataAccess.Entities
@using Microsoft.AspNetCore.Identity

@inject UserManager<FonbecWebUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirmación de registro</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">Confirmación de registro</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6 mud-text-secondary">
    Revisá tu correo para confirmar tu cuenta.
</MudText>

<StatusMessage Message="@_statusMessage" />

@code {
    private string? _statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Email is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            _statusMessage = "Error al encontrar el usuario para el correo indicado";
        }
    }
}
