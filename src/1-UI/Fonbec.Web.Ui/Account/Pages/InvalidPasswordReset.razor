@page "/Account/InvalidPasswordReset"

<PageTitle>Restablecimiento de contraseña inválido</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">Restablecimiento de contraseña inválido</MudText>
<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
    El enlace para restablecer la contraseña no es válido.
</MudAlert>

<div class="auth-layout__links mt-6">
    <MudLink Href="Account/ForgotPassword">Pedir un nuevo enlace</MudLink>
</div>
