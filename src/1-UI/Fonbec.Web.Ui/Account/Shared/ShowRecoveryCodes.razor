<MudText Typo="Typo.h6" GutterBottom="true">Códigos de recuperación</MudText>

<StatusMessage Message="@StatusMessage" />

<MudAlert Severity="Severity.Warning" Variant="Variant.Text">
    Guardá estos códigos en un lugar seguro.
</MudAlert>

<MudText Typo="Typo.body2" Class="my-4">
    Si perdés tu dispositivo y no tenés los códigos de recuperación, vas a perder el acceso a tu cuenta.
</MudText>

<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">@recoveryCode</MudChip>
    }
</MudStack>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
